<!DOCTYPE html>
<html>
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="format-detection" content="telephone=no">
		<meta http-equiv="X-UA-Compatible" content="IE=edge">
		<meta name="language" content="fr">
	</head>
	<body style="margin: 0;">
		<header style="background-color: #95a595;  margin: 0 auto; padding: 15px; color: #000 !important; font-weight: 700; text-align: center;">
			<img 
				src="cid:logo" 
				class="ui tiny centered image"
				width="90"
			>
			<div style="  margin: 0 auto; margin-top: 10px; text-transform: uppercase; color: #000 !important;">
				{{ data.headline }}
			</div>
		</header>
		{% block body %}{% endblock %}
		<footer style="background-color: #95a595;  color: #000 !important; margin: 0 auto; width:100%; padding: 15px; text-align: center;">		
			Copyright © {{ 'now' | date('Y') }} Kazen Garden. All rights reserved. 
		</footer>
	</body>
</html>
