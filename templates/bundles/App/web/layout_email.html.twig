<!DOCTYPE html>
<html>
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="format-detection" content="telephone=no">
		<meta http-equiv="X-UA-Compatible" content="IE=edge">
		<meta name="language" content="fr">
	</head>
	<body style="margin: 0;">
		<header style="background-color: #95a595; height:55px; margin: 0 auto; padding: 15px; color: #fff; font-weight: 700; text-align: center;">
			<div style="  margin: 0 auto; text-transform: uppercase;">
				{{ data.headline }}
			</div>
		</header>
		{% block body %}{% endblock %}
		<footer style="background-color: #95a595;  margin: 0 auto; width:100%; padding: 15px; height:55px; text-align: center;">		
			<img 
				src="cid:logo" 
				class="ui tiny centered image"
				width="55"
				height="55"
			>
		</footer>
	</body>
</html>
