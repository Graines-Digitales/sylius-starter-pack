<!DOCTYPE html>
<html>
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="format-detection" content="telephone=no">
		<meta http-equiv="X-UA-Compatible" content="IE=edge">
		<meta name="language" content="fr">
	</head>
	<body style="margin: 0;">
		<header style="background-color: #95a595; padding: 15px; color: #fff; font-weight: 700; text-align: center;">
			<nav style="padding: 10px 20px; margin: 0 auto;">
				<div style="padding: 0.5rem; min-height: inherit; margin: 0 auto; text-transform: uppercase;">
                	{{ data.headline }}
            	</div>
			</nav>
		</header>
		{% block body %}{% endblock %}
		<footer style="background-color: #95a595; width:100%; height:55px; text-align: center;">
			<div style="padding: 10px 20px;">
				<div style="color:#fff;">
					<span class="main-logo-wrap">
						<img 
							src="cid:logo" 
							class="ui tiny centered image"
							height="30"
						>
					</span>
				</div>
			</div>
		</footer>
	</body>
</html>
