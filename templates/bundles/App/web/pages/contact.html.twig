{% extends '@App/web/layout.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('contact-entry', null, 'app') }}
{% endblock %}

{% block header %}
    {% include '@App/web/_header.html.twig' %}
{% endblock %}

{% block content %}
    {{ dump() }}
{% endblock %}

{% block footer %}
    {% include '@App/web/_footer.html.twig' %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('vendor/jquery-3.6.0/jquery.min.js') }}"></script>
    <script src="{{ asset('vendor/jquery-3.6.0/jquery.validate.min.js') }}"></script>
    <script src="{{ asset('vendor/jquery-3.6.0/additional-methods.min.js') }}"></script>
    {{ encore_entry_script_tags('contact-entry', null, 'app') }}
{% endblock %}
