{% extends '@App/web/layout.html.twig' %}

{% block stylesheets %}
	{{ parent() }}
	{{ encore_entry_link_tags('home-entry', null, 'app') }}
{% endblock %}

{% block header %}
	{% include '@App/web/_header.html.twig' %}
{% endblock %}

{% block content %}
	<div class="container">
		<div class="row">
			<div class="col-md-6 mx-auto my-5 error-card">
				<h1>Erreur 404</h1>
				<p>Page non trouvée</p>
				<a class="my-4" href="{{ path('sylius_shop_homepage') }}">Revenir au site</a>
			</div>
		</div>
	</div>
{% endblock %}

{% block footer %}
	{% include '@App/web/_footer.html.twig' %}
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	{{ encore_entry_script_tags('home-entry', null, 'app') }}
{% endblock %}
