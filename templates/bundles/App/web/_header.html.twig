{% set menu = mainMenuHeader() %}
<header>
    <nav class="nav-top navbar navbar-expand-lg">
        <a class="navbar-brand" href="{{ path('sylius_shop_default_locale') }}">
            <span class="main-logo-wrap">
                mon logo
            </span>
        </a>
        <div class="collapse navbar-collapse">
            <div class="navbar-nav">
                {% for item in menu %}
                    <a 
                        class="nav-link {{ page.slug == item.slug ? 'active' :'' }}"
                        href="{{ path(item.route, item.params) }}"
                    >
                        {{ item.label }}
                    </a>
                {% endfor %}
            </div>
        </div>
    </nav>
</header>
