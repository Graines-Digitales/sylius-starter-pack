{% extends '@App/web/layout_email.html.twig' %}

{% block body %}
	<style>
		div {
			max-width: 600px;
			margin: auto;
			padding: 15px 30px;
			
			font-family: sans-serif;
		}
		p {
			text-align: center;
		}
		table {
			margin: 30px 0;
			border-collapse: collapse;
			width: 100%;
		}
		tr {
			border-bottom: 1px solid #c9002b;
		}
		td {
			padding: 5px 10px;

		}
	</style>
<div style=" ">
	<p>
		Votre message à bien été envoyé
		<br>
		Nous vous répondrons dans les meilleurs délais
	</p>
	<table>
		{% for key, item in data %}
			{% if key not in ['headline']%}
			<tr>
				<td><strong>{{ key }}</strong></td>
				<td>{{ item }}</td>
			</tr>
			{% endif %}
		{% endfor %}
	</table>
</div>
{% endblock %}
