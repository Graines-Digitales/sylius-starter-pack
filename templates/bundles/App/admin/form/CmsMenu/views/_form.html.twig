{{ form_row(form.isEnabled) }}
{{ form_row(form.name) }}
{# {{ form_row(form.code) }} #}
<div class="ui two column divided grid">
	<div class="row">
		<div class="column">
			{{ form_row(form.primaryImage) }}
		</div>
		<div class="column">
			{% if cms_menu.primaryImage is not null and cms_menu.primaryImage.filename is not null and cms_menu.primaryImage.filename != '' %}
				<div class="ui centered medium image">
					<img src="{{ asset(directory_image_media_object ~ '/' ~ cms_menu.primaryImage.filename) }}">
				</div>
			{% endif %}
		</div>
	</div>
</div>
{{ form_row(form.menus) }}
{{ form_row(form.cmsLinks) }}

