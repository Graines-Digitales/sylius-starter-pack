<h5 class="ui tiny header">
    {{element.designation}}
</h5>
{% if element.icon is defined and element.icon is not empty or element.primaryImage is defined and element.primaryImage is not empty or element.title is defined and element.title is not empty %}
<h2 class="ui huge header">
    {% if element.icon is defined and element.icon is not empty %}
        <img class="ui huge rounded image" src="{{ asset('media/icon/' ~ element.icon.filename) }}"/>
    {% elseif element.image is defined and element.image is not empty %}
        <img class="ui huge rounded image" src="{{ element.image.filename|imagine_filter('thumbnail_webp') }}" />
    {% endif %}
    <div class="content">
        {% if element.title is defined and element.title is not empty %}
            {{element.title}}
        {% endif %}
    </div>
</h2>
{% endif %}