{% if data is not empty %}
    <img 
        class="ui tiny bordered image" 
        src="{{ data.filename|imagine_filter('mini_webp') }}"
    />
{% else %}
    <img 
        class="ui tiny bordered image" 
        src="{{ asset('build/app/images/image-not-found.jpg') }}" 
        alt="Image not found"
    >
{% endif %} 